# Multi-stage Dockerfile for Go Deployment 2 (gRPC Server)
FROM golang:alpine AS builder

WORKDIR /app
COPY proto /proto
COPY go_deployment2 /app

RUN go mod tidy && CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/grpc_server ./grpc_server

FROM alpine:3.21
RUN apk --no-cache add ca-certificates curl
WORKDIR /app
COPY --from=builder /bin/grpc_server /bin/grpc_server

ENV PORT=50051
EXPOSE 50051

CMD ["/bin/grpc_server"]

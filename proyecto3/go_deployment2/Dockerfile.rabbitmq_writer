# Multi-stage Dockerfile for Go Deployment 2 (RabbitMQ Writer)
FROM golang:alpine AS builder

WORKDIR /app
COPY proto /proto
COPY go_deployment2 /app

RUN go mod tidy && CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/rabbitmq_writer ./rabbitmq_writer

FROM alpine:3.21
RUN apk --no-cache add ca-certificates curl
WORKDIR /app
COPY --from=builder /bin/rabbitmq_writer /bin/rabbitmq_writer

ENV PORT=8083
EXPOSE 8083

CMD ["/bin/rabbitmq_writer"]

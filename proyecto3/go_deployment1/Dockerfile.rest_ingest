# Multi-stage Dockerfile for Go Deployment 1 (Rest Ingest)
FROM golang:alpine AS builder

WORKDIR /app
COPY proto /proto
COPY go_deployment1 /app

RUN go mod tidy && CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/rest_ingest ./rest_ingest

FROM alpine:3.21
RUN apk --no-cache add ca-certificates curl
WORKDIR /app
COPY --from=builder /bin/rest_ingest /bin/rest_ingest

ENV PORT=8081
EXPOSE 8081

CMD ["/bin/rest_ingest"]
